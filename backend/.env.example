# Puerto donde escucha la API backend
PORT=8787

# development | production | test
NODE_ENV=development

# Orígenes permitidos para CORS, separados por coma (nunca usar *)
CORS_ORIGIN=http://localhost:5173
# Usar true detrás de un único proxy inverso confiable, por ejemplo Render.
TRUST_PROXY=false

# Credenciales del proyecto LiveKit (nunca exponer en el frontend)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Caducidad de los tokens de acceso de LiveKit (15 minutos por defecto)
LIVEKIT_TOKEN_TTL_SECONDS=900

# Grabación server-side con LiveKit Egress. Se mantiene apagada hasta
# configurar un bucket compatible con S3 y una clave de control privada.
RECORDING_ENABLED=false
RECORDING_CONTROL_SECRET=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
# Opcional para proveedores S3 compatibles (MinIO, Cloudflare R2, etc.).
RECORDING_S3_ENDPOINT=

# Historial de chat en Supabase. Solo el backend usa la secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
